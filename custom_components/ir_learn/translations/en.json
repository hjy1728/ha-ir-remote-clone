{
  "config": {
    "step": {
      "user": {
        "title": "IR Learn",
        "description": "Connect to an existing ESPHome IR receiver/transmitter node.",
        "data": {
          "esphome_node": "ESPHome node name (e.g. ir_controller)",
          "code_sensor": "IR code text sensor",
          "protocol": "Remote protocol"
        }
      }
    },
    "abort": {
      "already_configured": "This node is already configured"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Manage IR buttons",
        "description": "Choose an action",
        "menu_options": {
          "add_button": "Add buttons",
          "delete_button": "Delete buttons",
          "settings": "Transmitter settings"
        }
      },
      "add_button": {
        "title": "Add buttons",
        "description": "Enter one button name per line (or separate with commas). The first one becomes the learning target.",
        "data": {
          "names": "Button names (one per line)"
        }
      },
      "delete_button": {
        "title": "Delete buttons",
        "description": "Select multiple buttons; their entities will be removed from the integration as well.",
        "data": {
          "names": "Buttons to delete (multiple)"
        }
      },
      "settings": {
        "title": "Transmitter settings",
        "data": {
          "esphome_node": "ESPHome node name",
          "code_sensor": "IR code text sensor",
          "protocol": "Remote protocol"
        }
      }
    },
    "error": {
      "empty_name": "Name cannot be empty",
      "exists": "This button already exists"
    },
    "abort": {
      "no_buttons": "No buttons to delete",
      "not_found": "Button not found"
    }
  },
  "services": {
    "add_button": {
      "name": "Add button",
      "description": "Create one or more empty buttons; the first one becomes the learning target.",
      "fields": {
        "name": {
          "name": "Button name (single, legacy)",
          "description": "For example: TV-Power"
        },
        "names": {
          "name": "Button names",
          "description": "For example: TV-Power, TV-Volume+; use either this or name"
        },
        "config_entry_id": {
          "name": "Integration instance",
          "description": "Specify when multiple instances exist"
        }
      }
    },
    "delete_button": {
      "name": "Delete button",
      "description": "Delete one or more configured buttons and remove their entities.",
      "fields": {
        "name": {
          "name": "Button name (single, legacy)",
          "description": "For example: TV-Power"
        },
        "names": {
          "name": "Button names",
          "description": "For example: TV-Power, TV-Volume+; use either this or name"
        },
        "config_entry_id": {
          "name": "Integration instance",
          "description": "Specify when multiple instances exist"
        }
      }
    },
    "send_button": {
      "name": "Send button",
      "description": "Transmit the learned IR code by button name.",
      "fields": {
        "name": {
          "name": "Button name",
          "description": "For example: TV-Power"
        },
        "config_entry_id": {
          "name": "Integration instance",
          "description": "Specify when multiple instances exist"
        }
      }
    },
    "clear_buffer": {
      "name": "Clear captured code",
      "description": "Discard the code captured but not yet saved.",
      "fields": {
        "config_entry_id": {
          "name": "Integration instance",
          "description": "Specify when multiple instances exist"
        }
      }
    }
  }
}
